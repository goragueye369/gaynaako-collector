{
  "name": "gaynaako-collector",
  "version": "1.0.0",
  "description": "Collecteur d'opportunités local",
  "main": "pipeline-complet.js",
  "scripts": {
    "collect": "node collector/scraper.js",
    "clean": "node collector/data-cleaner.js",
