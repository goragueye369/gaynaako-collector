# ============================================
# GAYNAAKO COLLECTOR - Configuration
# ============================================
#
# Copiez ce fichier en .env et ajustez les valeurs
#   cp .env.example .env
#
# ⚠️ Ne jamais committer le fichier .env (contient des secrets)
# ============================================

# ── MySQL : Opportunités ────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=gaynaako_api
DB_PASSWORD=apipassword123
DB_NAME=gaynaako_opportunities

# ── MySQL : Profils & Recommandations ───────
DB_PROFILS_HOST=localhost
DB_PROFILS_PORT=3306
DB_PROFILS_USER=root
DB_PROFILS_PASSWORD=
DB_PROFILS_NAME=gaynaako_profils

# ── API REST ────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Intelligence Artificielle ───────────────
# Modèle d'embeddings pour le matching sémantique
# Options : BAAI/bge-m3 (recommandé) ou sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=BAAI/bge-m3

# ── Scheduler ───────────────────────────────
# Format cron : "minute heure * * *"
SCHEDULER_CRON=5 13 * * *

# ── Matching ────────────────────────────────
# Seuil minimal de compatibilité (0.0 à 1.0)
MIN_MATCH_SCORE=0.55
# Nombre de recommandations par profil
MAX_RECOMMENDATIONS=5
